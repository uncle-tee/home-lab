# =====================
# Authentik Database
# =====================
PG_DB=authentik
PG_USER=authentik
PG_PASS=authentikpass

# Authentik Secret Key
AUTHENTIK_SECRET_KEY=supersecretkey

# Authentik Docker image / tag
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=2026.2.1

# Authentik Ports
COMPOSE_PORT_HTTP=9000
COMPOSE_PORT_HTTPS=9443

# =====================
# Outline Database
# =====================
OUTLINE_DB=outline
OUTLINE_DB_USER=outline
OUTLINE_DB_PASS=outlinepass

# =====================
# Redis
# =====================
REDIS_PASSWORD=redispass

# =====================
# Outline OIDC (Authenik)
# =====================
OIDC_CLIENT_ID=outline-client-id
OIDC_CLIENT_SECRET=outline-client-secret
OIDC_ISSUER_URL=http://authentik:9000/application/o/outline/
OIDC_AUTH_URI=http://authentik:9000/application/o/authorize/
OIDC_TOKEN_URI=http://authentik:9000/application/o/token/
OIDC_USERINFO_URI=http://authentik:9000/application/o/userinfo/
OIDC_LOGOUT_URI=http://authentik:9000/application/o/end-session/
OIDC_USERNAME_CLAIM=email

# =====================
# Outline Local
# =====================
OUTLINE_HOST=localhost
OUTLINE_PORT=3000
OUTLINE_SECRET_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2
OUTLINE_UTILS_SECRET=f1e2d3c4b5a6f7e8d9c0b1a2f3e4d5c6b7a8f9e0d1c2b3a4f5e6d7c8b9a0f1e2
